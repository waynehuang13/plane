FROM nginx:1.27-alpine

# Install bash, curl, and gettext (for envsubst)
RUN apk add --no-cache bash curl gettext

# Copy nginx configuration template
COPY nginx.conf /etc/nginx/nginx.conf.template

# Create entrypoint script to substitute environment variables
RUN cat > /docker-entrypoint.sh <<'EOF'
#!/bin/bash
set -e

# Set default values for environment variables
export FILE_SIZE_LIMIT=${FILE_SIZE_LIMIT:-5242880}
export BUCKET_NAME=${BUCKET_NAME:-uploads}
export SITE_ADDRESS=${SITE_ADDRESS:-_}
export TRUSTED_PROXIES=${TRUSTED_PROXIES:-0.0.0.0/0}

# Substitute environment variables in nginx config
envsubst '${FILE_SIZE_LIMIT} ${BUCKET_NAME} ${SITE_ADDRESS} ${TRUSTED_PROXIES}' \
  < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf

# Start nginx
exec nginx -g 'daemon off;'
EOF

RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
